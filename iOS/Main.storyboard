<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard" version="3.0" toolsVersion="19529" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="iosVC">
    <device id="retina5_9" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="19519"/>
    </dependencies>
    <scenes>
        <scene sceneID="iosScene">
            <objects>
                <viewController id="iosVC" customClass="ViewController" customModule="WatchPlayer" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="iosRootView">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="812"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" distribution="equalSpacing" alignment="center" spacing="24" translatesAutoresizingMaskIntoConstraints="NO" id="iosStack">
                                <rect key="frame" x="24" y="344" width="327" height="124.33333333333337"/>
                                <subviews>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Send videos to your Apple Watch" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="iosTitleLbl">
                                        <rect key="frame" x="0.0" y="0.0" width="327" height="20.333333333333332"/>
                                        <fontDescription key="font" type="boldSystem" pointSize="17"/>
                                        <nil key="highlightedColor"/>
                                    </label>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="iosPickBtn">
                                        <rect key="frame" x="0.0" y="44.333333333333314" width="327" height="31"/>
                                        <state key="normal" title="Choose Videos"/>
                                        <connections>
                                            <action selector="pickTapped:" destination="iosVC" eventType="touchUpInside" id="iosActPick"/>
                                        </connections>
                                    </button>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Nothing queued yet" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="iosStatusLbl">
                                        <rect key="frame" x="0.0" y="99.333333333333371" width="327" height="25"/>
                                        <fontDescription key="font" type="system" pointSize="14"/>
                                        <color key="textColor" systemColor="secondaryLabelColor"/>
                                        <nil key="highlightedColor"/>
                                    </label>
                                </subviews>
                            </stackView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="iosSafeArea"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="iosStack" firstAttribute="leading" secondItem="iosSafeArea" secondAttribute="leading" constant="24" id="cA"/>
                            <constraint firstItem="iosStack" firstAttribute="trailing" secondItem="iosSafeArea" secondAttribute="trailing" constant="-24" id="cB"/>
                            <constraint firstItem="iosStack" firstAttribute="centerY" secondItem="iosSafeArea" secondAttribute="centerY" id="cC"/>
                        </constraints>
                    </view>
                    <connections>
                        <outlet property="statusLabel" destination="iosStatusLbl" id="iosOStatus"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iosFirstResp" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="30" y="25"/>
        </scene>
    </scenes>
    <resources>
        <systemColor name="secondaryLabelColor">
            <color red="0.23529411764705882" green="0.23529411764705882" blue="0.2627450980392157" alpha="0.59999999999999998" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
    </resources>
</document>
